---
/**
 * Media player powered by Plyr.
 * Docs: https://github.com/sampotts/plyr
 *
 * Supports HTML5 video/audio plus YouTube and Vimeo embeds. The accent color
 * follows the site theme.
 */

type HtmlMediaSource = {
  src: string;
  /** MIME type for this source. */
  mime?: string;
  /** Quality label used by Plyr, for example 1080 or 720. */
  size?: number;
};

interface Props {
  /** Source kind. */
  type?: "video" | "audio" | "youtube" | "vimeo";
  /**
   * Source. For `video`/`audio` a media URL; for `youtube`/`vimeo` the
   * video id or full watch URL.
   */
  src?: string;
  /**
   * Multiple HTML5 sources. Add `size` for video quality selection.
   * Example: `{ src: "/video-720p.mp4", mime: "video/mp4", size: 720 }`.
   */
  sources?: HtmlMediaSource[];
  /** Poster image (video only). */
  poster?: string;
  /** MIME type for HTML5 sources (defaults based on `type`). */
  mime?: string;
  /** Default video quality when multiple sized sources are provided. */
  defaultQuality?: number;
  class?: string;
}

const {
  type = "video",
  src,
  sources,
  poster,
  mime,
  defaultQuality,
  class: className,
} = Astro.props;

const isEmbed = type === "youtube" || type === "vimeo";
const embedFallbackUrl =
  isEmbed && src
    ? src.startsWith("http")
      ? src
      : type === "youtube"
        ? `https://www.youtube.com/watch?v=${src}`
        : `https://vimeo.com/${src}`
    : undefined;
const videoMime = mime ?? "video/mp4";
const audioMime = mime ?? "audio/mpeg";
const sourceList =
  sources?.length && !isEmbed ? sources : src ? [{ src, mime }] : [];
const qualityOptions = [
  ...new Set(
    sourceList
      .map(source => source.size)
      .filter((size): size is number => typeof size === "number")
  ),
].sort((a, b) => b - a);
const qualityDefault = defaultQuality ?? qualityOptions[0];
---

<div
  class:list={[
    "plyr-mount not-prose",
    (type === "video" || isEmbed) && "plyr-mount--video",
    className,
  ]}
  data-quality-options={qualityOptions.length > 1
    ? JSON.stringify(qualityOptions)
    : undefined}
  data-quality-default={qualityDefault}
>
  {
    type === "video" && (
      <video
        class="plyr-media"
        playsinline
        controls
        preload="none"
        poster={poster}
      >
        {sourceList.map(source => (
          <source
            src={source.src}
            type={source.mime ?? videoMime}
            {...(source.size ? { size: source.size } : {})}
          />
        ))}
      </video>
    )
  }
  {
    type === "audio" && (
      <audio class="plyr-media" controls preload="none">
        {sourceList.map(source => (
          <source src={source.src} type={source.mime ?? audioMime} />
        ))}
      </audio>
    )
  }
  {
    isEmbed && (
      <div
        class="plyr-media plyr-embed-fallback"
        data-plyr-provider={type}
        data-plyr-embed-id={src ?? ""}
      >
        {embedFallbackUrl && (
          <a href={embedFallbackUrl} target="_blank" rel="noopener noreferrer">
            在原站观看视频
          </a>
        )}
      </div>
    )
  }
</div>

<style is:global>
  .plyr-mount--video {
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .plyr-mount--video > .plyr-media,
  .plyr-mount--video > .plyr {
    width: 100%;
    height: 100%;
  }

  .plyr-embed-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .plyr-embed-fallback > a {
    color: white;
    text-decoration: underline;
  }

  /* Tie Plyr's accent to the site theme. */
  .plyr {
    --plyr-color-main: var(--accent);
  }
</style>

<script>
  import type Plyr from "plyr";

  const instances = new Map<HTMLElement, Plyr>();
  const pending = new Map<HTMLElement, number>();
  let observer: IntersectionObserver | null = null;
  let generation = 0;

  async function initPlayer(mount: HTMLElement) {
    if (instances.has(mount) || pending.has(mount)) return;
    const currentGeneration = generation;
    pending.set(mount, currentGeneration);

    try {
      const [{ default: Plyr }] = await Promise.all([
        import("plyr"),
        import("plyr/dist/plyr.css"),
      ]);
      if (generation !== currentGeneration || !mount.isConnected) return;
      const el = mount.querySelector<HTMLElement>(".plyr-media");
      if (!el) return;
      const qualityOptions = JSON.parse(
        mount.dataset.qualityOptions ?? "[]"
      ) as number[];
      const qualityDefault = Number(mount.dataset.qualityDefault);
      const options =
        qualityOptions.length > 1
          ? {
              quality: {
                default: Number.isFinite(qualityDefault)
                  ? qualityDefault
                  : qualityOptions[0],
                options: qualityOptions,
              },
            }
          : undefined;

      instances.set(mount, new Plyr(el, options));
    } catch (error) {
      if (generation === currentGeneration && mount.isConnected) {
        if (typeof reportError === "function") reportError(error);
        // Keep enhancement failures diagnosable in older browsers as well.
        // eslint-disable-next-line no-console
        else console.error("Player enhancement failed", error);
      }
    } finally {
      if (pending.get(mount) === currentGeneration) pending.delete(mount);
    }
  }

  function observePlayers() {
    observer?.disconnect();
    observer = null;
    const mounts = document.querySelectorAll<HTMLElement>(".plyr-mount");
    if (typeof IntersectionObserver === "undefined") {
      mounts.forEach(mount => void initPlayer(mount));
      return;
    }
    observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting)
            void initPlayer(entry.target as HTMLElement);
        });
      },
      { rootMargin: "400px" }
    );
    mounts.forEach(mount => {
      if (!instances.has(mount) && !pending.has(mount))
        observer?.observe(mount);
    });
  }

  function destroyPlayers() {
    generation++;
    observer?.disconnect();
    observer = null;
    for (const player of instances.values()) {
      try {
        player.destroy();
      } catch {
        /* already gone */
      }
    }
    instances.clear();
    pending.clear();
  }

  observePlayers();
  document.addEventListener("astro:page-load", observePlayers);
  document.addEventListener("astro:before-swap", destroyPlayers);
</script>
