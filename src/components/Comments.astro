---
/**
 * Waline comment system.
 * Docs: https://waline.js.org/
 *
 * The server is a self-hosted Waline instance. Override the URL per-project
 * by editing `WALINE_SERVER_URL` in `src/utils/waline.ts`.
 */
import { WALINE_SERVER_URL } from "@/utils/waline";

interface Props {
  /** Waline server URL. */
  serverURL?: string;
  /** Unique path used as the comment thread key. Defaults to the page pathname. */
  path?: string;
  /** Extra classes for the wrapper. */
  class?: string;
}

const {
  serverURL = WALINE_SERVER_URL,
  path,
  class: className,
} = Astro.props;
---

<section class:list={["mt-8", className]} aria-label="Comments">
  <div
    id="waline"
    data-server-url={serverURL}
    data-path={path}
    class="max-w-app"
  >
  </div>
</section>

<script>
  type WalineInstance = { destroy: () => void } | null;

  let waline: WalineInstance = null;
  let io: IntersectionObserver | null = null;

  async function initWaline() {
    const el = document.getElementById("waline");
    if (!el || el.dataset.walineInit) return;

    const serverURL = el.dataset.serverUrl;
    if (!serverURL) return;

    // Guard so the observer + astro:page-load don't double-init.
    el.dataset.walineInit = "true";

    // Load the Waline client (~285KB) + its styles only when the comment
    // section is about to enter the viewport — most readers never scroll here.
    const [{ init }] = await Promise.all([
      import("@waline/client"),
      import("@waline/client/style"),
    ]);

    waline = init({
      el: "#waline",
      serverURL,
      path: el.dataset.path || window.location.pathname,
      // Match AstroPaper's dark mode: <html> gets the `dark` class.
      dark: "html.dark",
      lang: document.documentElement.lang || "en",
      // Article reaction emojis (👍 etc.) shown above the comment box.
      reaction: true,
      // Emoji picker for the comment input.
      emoji: [
        "https://unpkg.com/@waline/emojis@1.2.0/weibo",
        "https://unpkg.com/@waline/emojis@1.2.0/tieba",
      ],
      locale: {
        placeholder: "Leave a comment...",
      },
    });
  }

  // Defer loading until the comment box nears the viewport.
  function observeWaline() {
    const el = document.getElementById("waline");
    if (!el || el.dataset.walineInit) return;
    io?.disconnect();
    io = new IntersectionObserver(
      entries => {
        if (entries.some(e => e.isIntersecting)) {
          io?.disconnect();
          io = null;
          initWaline();
        }
      },
      { rootMargin: "400px" }
    );
    io.observe(el);
  }

  observeWaline();
  document.addEventListener("astro:page-load", observeWaline);

  // Tear down before swapping pages to avoid leaking listeners/observers.
  document.addEventListener("astro:before-swap", () => {
    io?.disconnect();
    io = null;
    waline?.destroy();
    waline = null;
  });
</script>
